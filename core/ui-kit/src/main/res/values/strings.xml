<?xml version="1.0" encoding="utf-8"?>
<!--
    Shared keys consumed by callers of state views. Each composable in this
    module accepts strings as parameters (no implicit resource lookups), so
    these keys are referenced as `com.spectech.uikit.R.string.…` from the
    feature module that owns the screen.
-->
<resources>
    <!-- State views -->
    <string name="state_loading">Loading…</string>
    <string name="state_retry">Retry</string>
    <string name="state_error_title">Something went wrong</string>
    <string name="state_action_call">Call</string>
    <string name="state_action_copy">Copy phone</string>
    <string name="action_copy_address">Copy address</string>

    <!--
        Equipment operational status, parsed from
        `Equipment.characteristics` "Status: <value>" by
        [EquipmentCharacteristics.status]. Rendered as a small pill on the
        garage card hero image and on the detail screen header.
    -->
    <string name="equipment_status_available">Available</string>
    <string name="equipment_status_in_use">In Use</string>
    <string name="equipment_status_maintenance">Maintenance</string>

    <!-- Garage detail icon-row labels (used when rendering parsed characteristics). -->
    <string name="equipment_detail_vin">VIN</string>
    <string name="equipment_detail_city">City</string>
    <string name="equipment_detail_status">Status</string>

    <string name="sign_in">Sign in</string>

    <!--
        ApiError.LocalCodes → user-facing message resolution.
        Resolved by `ApiError.localizedMessage(context)` in core/ui-kit
        (see strings/ApiErrorStrings.kt). RU translations are sourced from
        iOS Localizable.xcstrings to keep both platforms wording-identical.
    -->
    <string name="error_invalid_response">The server returned an invalid response.</string>
    <string name="error_decoding_failed">The app could not read the server response.</string>
    <string name="error_missing_session">You need to sign in to continue.</string>
    <string name="error_invalid_phone">Enter a valid Russian phone number.</string>
    <string name="error_auth_required">Authentication required.</string>
    <string name="error_url_build_failed">Could not build the request URL.</string>
    <string name="error_generic_unknown">Something went wrong. Please try again.</string>
    <string name="error_otp_invalid_or_expired">The code is invalid or has expired. Please try again.</string>
    <string name="error_otp_rate_limited">Too many attempts. Please wait before trying again.</string>
    <string name="error_fallback_400">Some fields are invalid. Please review the form and try again.</string>
    <string name="error_fallback_401">Your session expired. Sign in again.</string>
    <string name="error_fallback_403">You do not have permission to perform this action.</string>
    <string name="error_fallback_404">The requested resource was not found.</string>
    <string name="error_fallback_429">Too many attempts. Please wait before trying again.</string>
    <string name="error_fallback_503">The SMS provider is temporarily unavailable. Try again later.</string>
    <string name="error_fallback_other">The server returned an unexpected error.</string>
    <string name="error_garage_category_required">Select an equipment type.</string>
    <string name="error_garage_photo_read_failed">Could not prepare the photo for upload.</string>
    <string name="error_network_offline">No internet connection. Check your network and try again.</string>
    <string name="error_ssl_failure">Secure connection to the server failed. Update the app or try again later.</string>
    <string name="error_server_timeout">The server took too long to respond. Try again.</string>

