<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon. The foreground PNG is a centered, transparently-padded
    rendering of the iOS app icon (SpecTechIOS AppIcon.appiconset/icon_1024.png)
    sized to fit Android's 66dp safe zone — that way the launcher mask never
    clips the excavator + handshake. Background stays as the brand blue so the
    crop around the artwork still feels on-brand.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
